<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <title>Toa thuốc tự túc</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="app-shell no-print">
  <section class="panel main-panel">
    <div class="topbar">
      <div>
        <h1>Toa thuốc tự túc</h1>
        <div class="muted">Đang đăng nhập: <b><%= doctor.title ? doctor.title + ' ' : '' %><%= doctor.full_name %></b></div>
      </div>
      <div class="topbar-actions">
        <% if (doctor.is_admin) { %>
          <a class="button-link" href="/users">Quản lý user</a>
        <% } %>
        <form method="post" action="/logout"><button type="submit" class="secondary">Đăng xuất</button></form>
      </div>
    </div>
    <p class="muted">Bấm In / Xuất PDF A5 sẽ tự động lưu toa trước khi mở cửa sổ in.</p>

    <div class="grid2">
      <label>Chọn bệnh nhân cũ
        <select id="patientSelect">
          <option value="">-- Bệnh nhân mới --</option>
          <% patients.forEach(p => { %>
            <option value='<%- JSON.stringify(p) %>'><%= p.name %> <%= p.age ? ' - ' + p.age + ' tuổi' : '' %></option>
          <% }) %>
        </select>
      </label>
      <label>Ngày ký toa <input id="prescription_date" type="date"></label>
    </div>

    <div class="grid2">
      <label>Họ và tên <input id="patient_name"></label>
      <label>Giới tính
        <select id="gender">
          <option value="">-- Chọn --</option>
          <option value="Nam">Nam</option>
          <option value="Nữ">Nữ</option>
        </select>
      </label>
      <label>Tuổi <input id="age"></label>
      <label>Chẩn đoán <input id="diagnosis"></label>
      <label>Khoa / Phòng
        <select id="department">
          <option value="Phòng khám Ung Bướu">Phòng khám Ung Bướu</option>
          <option value="Khoa Ung Bướu">Khoa Ung Bướu</option>
        </select>
      </label>
    </div>

    <h2>Kê thuốc</h2>
    <div id="medicineRows"></div>
    <div class="actions"><button id="addRow" type="button">+ Thêm dòng thuốc</button></div>

    <label>Dặn dò chung <textarea id="advice" rows="2"></textarea></label>

    <div class="actions">
      <button id="saveBtn" type="button">Lưu toa</button>
      <button id="printBtn" type="button">In / Xuất PDF A5</button>
      <button id="newBtn" type="button" class="secondary">Toa mới</button>
    </div>
    <div id="status"></div>
  </section>

  <section class="panel side-panel">
    <h2>Danh mục thuốc tham khảo</h2>
    <div class="grid-med-form">
      <input id="newMedName" placeholder="Tên thuốc">
      <input id="newMedQty" placeholder="Số lượng">
      <input id="newMedDays" placeholder="Số lần/ngày">
      <input id="newMedDose" placeholder="Mỗi lần">
      <input id="newMedRoute" placeholder="Cách dùng / thời điểm">
      <input id="newMedIns" placeholder="Dặn dò riêng">
    </div>
    <div class="actions">
      <button id="saveMedBtn" type="button">Lưu thuốc</button>
      <button id="clearMedBtn" type="button" class="secondary">Xóa ô nhập</button>
    </div>
    <div id="medicineList" class="medicine-list"></div>

    <h2>Lịch sử toa</h2>
    <div id="history" class="history-list"></div>
    <div class="guide">Bấm vào toa cũ để nạp lại toa thuốc.</div>
  </section>
</div>

<main class="paper a5" id="printArea">
  <header class="rx-header">
    <div class="logo-wrap">
      <img src="/logo.png" class="hospital-logo" alt="logo">
    </div>
    <div class="hospital">
      <div>Bệnh viện Đa khoa Thủ Đức</div>
      <div id="pv_department">Phòng khám Ung Bướu</div>
    </div>
  </header>

  <section class="patient-block">
    <div><b>Họ và tên: <span id="pv_name"></span></b></div>
    <div class="patient-line-2"><b>Giới tính: <span id="pv_gender"></span></b><b>Tuổi: <span id="pv_age"></span></b></div>
    <div><b>Chẩn đoán: <span id="pv_diagnosis"></span></b></div>
  </section>

  <h1 class="title">ĐƠN THUỐC</h1>
  <section id="pv_items" class="items"></section>
  <div class="advice-line">Dặn dò: <span id="pv_advice"></span></div>

  <footer class="rx-footer">
    <div></div>
    <div class="doctor-box">
      <div id="pv_today_sign">Ngày …. Tháng ….. Năm …......</div>
      <div><b>Bác sĩ khám bệnh</b></div>
      <div class="signature-space"></div>
      <strong id="pv_doctor_name"><%= doctor.title ? doctor.title + " " : "" %><%= doctor.full_name %></strong>
    </div>
  </footer>
</main>

<script>window.INIT_MEDICINES = <%- JSON.stringify(medicines) %>; window.CURRENT_DOCTOR = <%- JSON.stringify(doctor) %>;</script>
<script src="/app.js"></script>
</body>
</html>
